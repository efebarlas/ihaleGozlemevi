{
  // Worker for İhale Gözlemevi: core pages are static assets, bulk pages are served from D1.
  // Unlisted: no routes, no custom domain.
  "name": "ihale-gozlemevi",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the bulk prefixes reach the Worker first; everything else is served by the asset layer
    // (the Worker still wraps unknown paths via the 404 page).
    "run_worker_first": ["/ihale/*", "/idare/*", "/yuklenici/*", "/gun/*"]
  },
  "d1_databases": [
    {
      "binding": "PAGES",
      "database_name": "ihale-pages",
      // Created 2026-11-19 with --location eeur (free tier).
      "database_id": "01cda293-2db0-4cd3-a037-f9aaecaccadd"
    }
  ]
}
