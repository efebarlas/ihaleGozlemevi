{
  // Worker for İhale Gözlemevi: core pages are static assets, bulk pages are served from D1.
  // Unlisted: no routes, no custom domain.
  "name": "ihale-gozlemevi",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Every request goes through the Worker first so that all responses (static HTML too) carry
    // charset=utf-8 and X-Robots-Tag. Core pages still never touch D1.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "PAGES",
      "database_name": "ihale-pages",
      // Created 2026-11-19 with --location eeur (free tier).
      "database_id": "01cda293-2db0-4cd3-a037-f9aaecaccadd"
    }
  ]
}
